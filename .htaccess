# BEGIN Magzest security headers
# Generated by deploy/make-htaccess.mjs from the built pages. Don't edit by
# hand: run .\build.ps1 instead. If the host already has a .htaccess, paste
# this block into it rather than replacing the file.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-i0fcLzdq0vluPE2moPUnhqKbjtNpbZn4xSOh1qdD0ls=' 'sha256-yA7UzTaD/p8HPCXKdhCAzsTEbYt50ZNausatEn6xjSA=' https://unpkg.com https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com; font-src 'self' data: https://fonts.gstatic.com https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com; connect-src 'self' https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com wss://*.zohopublic.in wss://*.zoho.in https://formsubmit.co https://bigin.zoho.in; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://*.zohopublic.in https://*.zoho.in https://*.zohocdn.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# END Magzest security headers
