# Copy this file to server/.env and fill it in. Never commit .env.

NODE_ENV=production
PORT=3000
# Public URL of the site (used in emails, sitemap, social tags)
SITE_URL=https://www.magzest.tech
# Set to 1 when running behind a reverse proxy / platform load balancer
# (Render, Railway, Nginx, Cloudflare...) so rate limits see real visitor IPs
TRUST_PROXY=1

# Long random string that signs admin login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Admin sign-in lasts while you're active: it ends after SESSION_IDLE_MINUTES
# without activity, or SESSION_HOURS after signing in, whichever is first.
SESSION_IDLE_MINUTES=120
SESSION_HOURS=168

# Encrypts personal data at rest (form submissions, subscriber emails, CRM
# notes, resumes). Generate one the same way as SESSION_SECRET. KEEP A COPY
# SOMEWHERE SAFE: without it the data and every backup are unreadable, and
# it can't be changed once data has been encrypted with it.
DATA_ENCRYPTION_KEY=

# First admin account — created automatically on first start if no admin
# exists yet. You can remove these afterwards and change the password
# from Admin > Settings.
ADMIN_EMAIL=hameed@magzest.in
ADMIN_PASSWORD=
# Two-step sign-in: after the password, a 6-digit code is emailed to the
# admin (needs the SMTP settings below). Set to false to turn it off.
ADMIN_MFA=true

# Address of the admin dashboard (default: adminn, i.e. /adminn/).
# Anything else, including /admin, shows the normal "page not found" page.
# ADMIN_PATH=adminn

# SMTP for outgoing email (e.g. Zoho: smtp.zoho.in:465, Google Workspace:
# smtp.gmail.com:465 with an app password, Hostinger: smtp.hostinger.com:465)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@magzest.tech
SMTP_PASS=
MAIL_FROM=Magzest <contact@magzest.tech>
# Where job-application and newsletter notifications go (also the
# reply-to address on auto-replies)
NOTIFY_EMAIL=contact@magzest.tech
# Contact-form and consultation-booking alerts (comma-separated)
LEADS_EMAIL=ranjithkumar@magzest.in,nithin@magzest.tech,hameed@magzest.tech,srilatha@magzest.tech,harini@magzest.tech
# Send confirmation emails to people who submit forms (true/false)
AUTO_REPLY=true

# Bigin CRM: website leads are forwarded to the Bigin "Contact us" web form
# (bigin.zoho.in). Keys come from the hidden xnQsjsdp / xmIwtLD inputs in the
# form's source code. Leave empty to turn the sync off (e.g. for local testing).
BIGIN_FORM_XNQSJSDP=
BIGIN_FORM_XMIWTLD=

# Where the database and uploads live (relative to server/). On hosts with
# ephemeral disks (Render, Railway) point this at a mounted persistent disk.
DATA_DIR=data
